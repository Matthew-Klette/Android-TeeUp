# Copy to keystore.properties (gitignored) to sign release builds. Never commit the real file.
# CI can supply the same values as TEEUP_KEYSTORE_PATH / TEEUP_KEYSTORE_PASSWORD /
# TEEUP_KEY_ALIAS / TEEUP_KEY_PASSWORD environment variables instead.
storeFile=/absolute/path/to/teeup-upload-key.jks
storePassword=CHANGE_ME
keyAlias=teeup-upload
keyPassword=CHANGE_ME
