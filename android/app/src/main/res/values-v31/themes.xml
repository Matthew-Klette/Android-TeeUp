<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Android 12+ always shows a system splash before the first frame. Make it
         the bare intro stage (no icon) so it hands straight into the golf intro. -->
    <style name="Theme.TeeUp.Splash" parent="Base.Theme.TeeUp.Splash">
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowSplashScreenBackground">@color/teeup_splash_stage</item>
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
    </style>

</resources>
