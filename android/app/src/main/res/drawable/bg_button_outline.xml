<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/teeup_ripple">

    <item>
        <selector>
            <!-- Disabled button -->
            <item android:state_enabled="false">
                <shape android:shape="rectangle">
                    <solid android:color="@color/teeup_surface" />
                    <stroke
                        android:width="1dp"
                        android:color="@color/teeup_border" />
                    <corners android:radius="@dimen/button_radius" />
                </shape>
            </item>

            <!-- Keyboard or directional-navigation focus -->
            <item android:state_focused="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/teeup_surface_alt" />
                    <stroke
                        android:width="1.5dp"
                        android:color="@color/teeup_accent" />
                    <corners android:radius="@dimen/button_radius" />
                </shape>
            </item>

            <!-- Normal button: a quiet hairline, not a second accent color -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/teeup_surface" />
                    <stroke
                        android:width="1dp"
                        android:color="@color/teeup_border" />
                    <corners android:radius="@dimen/button_radius" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
