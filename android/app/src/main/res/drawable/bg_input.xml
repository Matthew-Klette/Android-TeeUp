<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Focused input field -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/teeup_surface" />

            <stroke
                android:width="1dp"
                android:color="@color/teeup_accent" />

            <corners android:radius="@dimen/card_radius" />
        </shape>
    </item>

    <!-- Normal input field -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/teeup_surface" />

            <stroke
                android:width="1dp"
                android:color="@color/teeup_border" />

            <corners android:radius="@dimen/card_radius" />
        </shape>
    </item>

</selector>