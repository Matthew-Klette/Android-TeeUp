<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <ripple android:color="#33FFFFFF">
            <item>
                <selector>
                    <!-- Disabled button -->
                    <item android:state_enabled="false">
                        <shape android:shape="rectangle">
                            <solid android:color="@color/teeup_surface_alt" />
                            <corners android:radius="@dimen/button_radius" />
                        </shape>
                    </item>

                    <!-- Pressed -->
                    <item android:state_pressed="true">
                        <shape android:shape="rectangle">
                            <solid android:color="@color/teeup_primary_pressed" />
                            <corners android:radius="@dimen/button_radius" />
                        </shape>
                    </item>

                    <!-- Normal: solid brand fill, the one strong call to action per screen -->
                    <item>
                        <shape android:shape="rectangle">
                            <solid android:color="@color/teeup_primary" />
                            <corners android:radius="@dimen/button_radius" />
                        </shape>
                    </item>
                </selector>
            </item>
        </ripple>
    </item>

    <!-- Soft glass sheen across the top half for a tactile, premium finish -->
    <item android:bottom="20dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#29FFFFFF"
                android:endColor="#00FFFFFF" />
            <corners
                android:topLeftRadius="@dimen/button_radius"
                android:topRightRadius="@dimen/button_radius"
                android:bottomLeftRadius="0dp"
                android:bottomRightRadius="0dp" />
        </shape>
    </item>

</layer-list>
