<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33E2574C">

    <item>
        <selector>
            <item android:state_enabled="false">
                <shape android:shape="rectangle">
                    <solid android:color="@color/teeup_surface" />
                    <stroke android:width="1dp" android:color="@color/teeup_border" />
                    <corners android:radius="@dimen/button_radius" />
                </shape>
            </item>

            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/teeup_danger_muted" />
                    <stroke android:width="1dp" android:color="@color/teeup_danger" />
                    <corners android:radius="@dimen/button_radius" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
