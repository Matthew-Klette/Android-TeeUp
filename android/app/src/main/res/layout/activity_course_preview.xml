<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_screen_gradient">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/screen_padding"
        android:layout_marginStart="@dimen/screen_padding"
        android:layout_marginEnd="@dimen/screen_padding"
        android:layout_marginBottom="@dimen/space_lg"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/button_back"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:contentDescription="@string/detail_back"
            android:text="@string/detail_back_symbol"
            android:textColor="@color/teeup_text_primary"
            android:textSize="@dimen/text_heading" />

        <TextView
            android:id="@+id/text_course_preview_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_sm"
            android:layout_weight="1"
            android:text="@string/course_preview_title"
            android:textColor="@color/teeup_text_primary"
            android:textSize="@dimen/text_heading"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Satellite map card -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/screen_padding"
        android:layout_marginEnd="@dimen/screen_padding"
        android:layout_marginBottom="@dimen/space_lg"
        android:background="@drawable/bg_card"
        android:elevation="@dimen/elevation_card"
        android:clipToOutline="true">

        <WebView
            android:id="@+id/webview_course_map"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/text_course_preview_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="@dimen/screen_padding"
            android:accessibilityLiveRegion="polite"
            android:text="@string/course_preview_loading"
            android:textColor="@color/teeup_text_secondary"
            android:textSize="@dimen/text_body" />

    </FrameLayout>

    <!-- Rating + open-in-maps -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_padding"
        android:layout_marginEnd="@dimen/screen_padding"
        android:layout_marginBottom="@dimen/screen_padding"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/text_course_preview_rating"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/teeup_text_secondary"
            android:textSize="@dimen/text_body_large"
            android:visibility="gone" />

        <Button
            android:id="@+id/button_open_in_maps"
            style="@style/TeeUpButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/course_preview_open_maps" />

    </LinearLayout>

</LinearLayout>
