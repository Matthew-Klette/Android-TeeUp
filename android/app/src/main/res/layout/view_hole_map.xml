<?xml version="1.0" encoding="utf-8"?>
<!-- The hole map inside the Compose Scorecard and Hole Map screens. HoleMapController finds these
     two views by id; the Compose card behind it clips it and paints the dark map background. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <WebView
        android:id="@+id/webview_hole_map"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/text_map_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="24dp"
        android:accessibilityLiveRegion="polite"
        android:fontFamily="@font/inter_medium"
        android:gravity="center"
        android:text="@string/hole_map_loading"
        android:textColor="#E6FFFFFF"
        android:textSize="17sp" />

</FrameLayout>
