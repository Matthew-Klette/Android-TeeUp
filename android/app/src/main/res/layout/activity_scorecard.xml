<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_screen_gradient">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/screen_padding">

            <Button android:id="@+id/button_back" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="@string/wireflow_back" />
            <TextView android:id="@+id/round_reference" style="@style/TeeUpText"
                android:layout_width="match_parent" android:layout_height="wrap_content" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/scorecard_title"
                android:textColor="@color/teeup_text_primary"
                android:textSize="@dimen/text_heading"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text_entry_notice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:layout_marginBottom="@dimen/space_lg"
                android:text="@string/scorecard_entry_notice"
                android:textColor="@color/teeup_text_secondary"
                android:textSize="@dimen/text_body" />

            <ProgressBar android:id="@+id/scorecard_progress"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="center" android:visibility="gone" />

            <LinearLayout
                android:id="@+id/group_entry_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/text_hole_heading"
                    style="@style/TeeUpEyebrow"
                    android:layout_width="match_parent"
                    android:layout_marginBottom="@dimen/space_md"
                    android:textSize="@dimen/text_subheading"
                    android:text="@string/scorecard_hole_heading" />

                <!-- Score entry -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_lg"
                    android:background="@drawable/bg_card_outline"
                    android:elevation="@dimen/elevation_card"
                    android:orientation="vertical"
                    android:padding="@dimen/space_lg">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/space_sm"
                        android:text="@string/scorecard_strokes"
                        android:textColor="@color/teeup_text_secondary"
                        android:textSize="@dimen/text_body_large" />

                    <EditText
                        android:id="@+id/input_strokes"
                        style="@style/TeeUpInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/space_lg"
                        android:hint="@string/scorecard_strokes_hint"
                        android:inputType="number"
                        android:maxLength="2" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/space_sm"
                        android:text="@string/scorecard_putts"
                        android:textColor="@color/teeup_text_secondary"
                        android:textSize="@dimen/text_body_large" />

                    <EditText
                        android:id="@+id/input_putts"
                        style="@style/TeeUpInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/scorecard_putts_hint"
                        android:inputType="number"
                        android:maxLength="2" />

                </LinearLayout>

                <TextView
                    android:id="@+id/text_progress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_md"
                    android:gravity="center"
                    android:textColor="@color/teeup_text_secondary"
                    android:textSize="@dimen/text_caption" />

                <Button
                    android:id="@+id/button_next_hole"
                    style="@style/TeeUpButton.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_sm"
                    android:text="@string/scorecard_next_hole" />

                <Button
                    android:id="@+id/button_finish_early"
                    style="@style/TeeUpButton.Compact"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/scorecard_finish_early" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <include layout="@layout/bottom_nav" />

</LinearLayout>
