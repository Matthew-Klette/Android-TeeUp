<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_screen_gradient">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/screen_padding">

            <Button android:id="@+id/button_back" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="@string/wireflow_back" />
            <TextView android:id="@+id/round_reference" style="@style/TeeUpText"
                android:layout_width="match_parent" android:layout_height="wrap_content" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/scorecard_title"
                android:textColor="@color/teeup_text_primary"
                android:textSize="@dimen/text_heading"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:layout_marginBottom="@dimen/space_lg"
                android:text="@string/scorecard_preview_notice"
                android:textColor="@color/teeup_text_secondary"
                android:textSize="@dimen/text_body" />

            <TextView
                style="@style/TeeUpEyebrow"
                android:layout_width="match_parent"
                android:layout_marginBottom="@dimen/space_md"
                android:textSize="@dimen/text_body"
                android:text="@string/scorecard_sample_hole" />

            <!-- Distance and map preview -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_lg"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_sm"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card"
                    android:elevation="@dimen/elevation_card"
                    android:orientation="vertical"
                    android:padding="@dimen/space_lg">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/scorecard_distance_label"
                        android:textColor="@color/teeup_text_secondary"
                        android:textSize="@dimen/text_caption" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:text="@string/scorecard_sample_distance"
                        android:textColor="@color/teeup_text_primary"
                        android:textSize="@dimen/text_subheading"
                        android:textStyle="bold" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card"
                    android:elevation="@dimen/elevation_card"
                    android:orientation="vertical"
                    android:padding="@dimen/space_lg">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/scorecard_map_label"
                        android:textColor="@color/teeup_text_secondary"
                        android:textSize="@dimen/text_caption" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:text="@string/scorecard_map_placeholder"
                        android:textColor="@color/teeup_text_primary"
                        android:textSize="@dimen/text_body" />

                </LinearLayout>

            </LinearLayout>

            <!-- Sample scores -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_xl"
                android:background="@drawable/bg_card_outline"
                android:elevation="@dimen/elevation_card"
                android:orientation="vertical"
                android:padding="@dimen/space_lg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_md"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/scorecard_strokes"
                        android:textColor="@color/teeup_text_secondary"
                        android:textSize="@dimen/text_body_large" />

                    <TextView
                        android:id="@+id/text_strokes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/scorecard_sample_strokes"
                        android:textColor="@color/teeup_text_primary"
                        android:textSize="@dimen/text_subheading"
                        android:textStyle="bold" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/scorecard_putts"
                        android:textColor="@color/teeup_text_secondary"
                        android:textSize="@dimen/text_body_large" />

                    <TextView
                        android:id="@+id/text_putts"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/scorecard_sample_putts"
                        android:textColor="@color/teeup_text_primary"
                        android:textSize="@dimen/text_subheading"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

            <TextView
                style="@style/TeeUpEyebrow"
                android:layout_width="match_parent"
                android:layout_marginBottom="@dimen/space_md"
                android:text="@string/scorecard_group_heading" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_sm"
                android:background="@drawable/bg_card"
                android:elevation="@dimen/elevation_card"
                android:padding="@dimen/space_lg"
                android:text="@string/scorecard_sample_player_two"
                android:textColor="@color/teeup_text_primary"
                android:textSize="@dimen/text_body" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_sm"
                android:background="@drawable/bg_card"
                android:elevation="@dimen/elevation_card"
                android:padding="@dimen/space_lg"
                android:text="@string/scorecard_sample_player_three"
                android:textColor="@color/teeup_text_primary"
                android:textSize="@dimen/text_body" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_lg"
                android:background="@drawable/bg_card"
                android:elevation="@dimen/elevation_card"
                android:padding="@dimen/space_lg"
                android:text="@string/scorecard_sample_player_four"
                android:textColor="@color/teeup_text_primary"
                android:textSize="@dimen/text_body" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_md"
                android:gravity="center"
                android:padding="@dimen/space_md"
                android:text="@string/scorecard_save_notice"
                android:textColor="@color/teeup_text_secondary"
                android:textSize="@dimen/text_caption" />

            <Button
                android:id="@+id/button_next_hole"
                style="@style/TeeUpButton.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/scorecard_summary_preview" />

        </LinearLayout>

    </ScrollView>


</LinearLayout>
