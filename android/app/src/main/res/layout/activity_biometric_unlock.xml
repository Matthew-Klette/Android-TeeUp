<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="@dimen/screen_padding"
    android:background="@drawable/bg_screen_gradient">

    <View
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginBottom="@dimen/space_lg"
        android:background="@drawable/bg_avatar_circle"
        android:importantForAccessibility="no" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_xxl"
        android:gravity="center"
        android:text="@string/app_name"
        android:textColor="@color/teeup_text_primary"
        android:textSize="@dimen/text_heading"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/text_unlock_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_xl"
        android:gravity="center"
        android:accessibilityLiveRegion="polite"
        android:textColor="@color/teeup_text_secondary"
        android:textSize="@dimen/text_body" />

    <Button
        android:id="@+id/button_try_again"
        style="@style/TeeUpButton.Primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_md"
        android:text="@string/biometric_unlock_try_again"
        android:visibility="gone" />

    <TextView
        android:id="@+id/text_sign_out_instead"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/touch_target"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:padding="@dimen/space_md"
        android:text="@string/biometric_unlock_sign_out_instead"
        android:textColor="@color/teeup_accent_secondary"
        android:textSize="@dimen/text_body"
        android:visibility="gone" />

</LinearLayout>
