<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/teeup_background" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="@dimen/screen_padding">
        <Button android:id="@+id/button_back" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="@string/wireflow_back" />
        <TextView style="@style/TeeUpText" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/summary_title" android:textSize="@dimen/text_heading" android:textStyle="bold" />
        <TextView android:id="@+id/round_reference" style="@style/TeeUpText"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_sm" />
        <TextView style="@style/TeeUpText" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_lg" android:text="@string/summary_preview" />

        <ProgressBar android:id="@+id/summary_progress"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="center" android:visibility="gone" />

        <LinearLayout
            android:id="@+id/summary_totals"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_lg"
            android:background="@drawable/bg_card_outline"
            android:elevation="@dimen/elevation_card"
            android:orientation="vertical"
            android:padding="@dimen/space_lg">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_md" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="@string/summary_holes_played" android:textColor="@color/teeup_text_secondary" android:textSize="@dimen/text_body_large" />
                <TextView android:id="@+id/text_holes_played" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="@color/teeup_text_primary" android:textSize="@dimen/text_subheading" android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_md" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="@string/summary_total_strokes" android:textColor="@color/teeup_text_secondary" android:textSize="@dimen/text_body_large" />
                <TextView android:id="@+id/text_total_strokes" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="@color/teeup_text_primary" android:textSize="@dimen/text_subheading" android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_md" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="@string/summary_total_putts" android:textColor="@color/teeup_text_secondary" android:textSize="@dimen/text_body_large" />
                <TextView android:id="@+id/text_total_putts" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="@color/teeup_text_primary" android:textSize="@dimen/text_subheading" android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_md" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="@string/summary_avg_putts" android:textColor="@color/teeup_text_secondary" android:textSize="@dimen/text_body_large" />
                <TextView android:id="@+id/text_avg_putts" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="@color/teeup_text_primary" android:textSize="@dimen/text_subheading" android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_md" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="@string/summary_net_score" android:textColor="@color/teeup_text_secondary" android:textSize="@dimen/text_body_large" />
                <TextView android:id="@+id/text_net_score" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="@color/teeup_text_primary" android:textSize="@dimen/text_subheading" android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="@string/summary_stableford_score" android:textColor="@color/teeup_text_secondary" android:textSize="@dimen/text_body_large" />
                <TextView android:id="@+id/text_stableford_score" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="@color/teeup_text_primary" android:textSize="@dimen/text_subheading" android:textStyle="bold" />
            </LinearLayout>

            <TextView android:id="@+id/text_handicap_hint" style="@style/TeeUpText"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm" android:text="@string/summary_handicap_hint"
                android:textColor="@color/teeup_text_secondary" android:visibility="gone" />

        </LinearLayout>

        <TextView
            style="@style/TeeUpEyebrow"
            android:layout_width="match_parent"
            android:layout_marginBottom="@dimen/space_md"
            android:text="@string/scorecard_title" />

        <LinearLayout android:id="@+id/holes_container"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_lg"
            android:orientation="vertical" />

        <Button
            android:id="@+id/button_done"
            style="@style/TeeUpButton.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_sm"
            android:text="@string/summary_done" />

        <Button
            android:id="@+id/button_delete_round"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_button_danger_outline"
            android:textColor="@color/teeup_danger"
            android:text="@string/summary_delete_round"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
