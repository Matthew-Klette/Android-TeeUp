<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/teeup_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="24dp"
        android:paddingRight="24dp"
        android:paddingTop="32dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Create your profile"
            android:textColor="@color/teeup_text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="EME-296 owns the real form + validation"
            android:textColor="@color/teeup_text_secondary"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/input_display_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_card"
            android:hint="Display name"
            android:padding="12dp"
            android:textColor="@color/teeup_text_primary" />

        <EditText
            android:id="@+id/input_handicap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_card"
            android:hint="Handicap index"
            android:inputType="numberDecimal"
            android:padding="12dp"
            android:textColor="@color/teeup_text_primary" />

        <EditText
            android:id="@+id/input_home_course"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_card"
            android:hint="Home course"
            android:padding="12dp"
            android:textColor="@color/teeup_text_primary" />

        <EditText
            android:id="@+id/input_pace"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_card"
            android:hint="Pace of play (Relaxed / Standard / Brisk)"
            android:padding="12dp"
            android:textColor="@color/teeup_text_primary" />

        <Button
            android:id="@+id/button_continue"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_button_outline"
            android:text="Continue"
            android:textColor="@color/teeup_accent" />

    </LinearLayout>
</ScrollView>
