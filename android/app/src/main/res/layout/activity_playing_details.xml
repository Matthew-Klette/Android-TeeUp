<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/bg_screen_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_lg"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/button_back"
                android:layout_width="@dimen/touch_target"
                android:layout_height="@dimen/touch_target"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:contentDescription="@string/detail_back"
                android:text="@string/detail_back_symbol"
                android:textColor="@color/teeup_text_primary"
                android:textSize="@dimen/text_heading" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_sm"
                android:layout_weight="1"
                android:text="@string/playing_details_title"
                android:textColor="@color/teeup_text_primary"
                android:textSize="@dimen/text_heading"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:id="@+id/text_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_md"
            android:background="@drawable/bg_card"
            android:elevation="@dimen/elevation_card"
            android:gravity="center"
            android:padding="@dimen/screen_padding"
            android:accessibilityLiveRegion="polite"
            android:text="@string/playing_details_loading"
            android:textColor="@color/teeup_text_secondary"
            android:textSize="@dimen/text_body" />

        <LinearLayout
            android:id="@+id/group_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_sm"
                android:labelFor="@id/input_handicap"
                android:text="@string/register_handicap"
                android:textColor="@color/teeup_text_primary"
                android:textSize="@dimen/text_body" />

            <EditText
                android:id="@+id/input_handicap"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_lg"
                android:hint="@string/register_handicap_hint"
                android:inputType="numberDecimal" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_sm"
                android:labelFor="@id/input_home_course"
                android:text="@string/register_home_course"
                android:textColor="@color/teeup_text_primary"
                android:textSize="@dimen/text_body" />

            <Spinner
                android:id="@+id/input_home_course"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_lg" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_sm"
                android:labelFor="@id/input_pace"
                android:text="@string/register_pace"
                android:textColor="@color/teeup_text_primary"
                android:textSize="@dimen/text_body" />

            <Spinner
                android:id="@+id/input_pace"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_xl" />

            <Button
                android:id="@+id/button_save"
                style="@style/TeeUpButton.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/playing_details_save" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
