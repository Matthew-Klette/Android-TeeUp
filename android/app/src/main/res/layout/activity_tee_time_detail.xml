<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/bg_screen_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_lg"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/button_back"
                android:layout_width="@dimen/touch_target"
                android:layout_height="@dimen/touch_target"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:contentDescription="@string/detail_back"
                android:text="@string/detail_back_symbol"
                android:textColor="@color/teeup_text_primary"
                android:textSize="@dimen/text_heading" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_sm"
                android:layout_weight="1"
                android:text="@string/detail_title"
                android:textColor="@color/teeup_text_primary"
                android:textSize="@dimen/text_heading"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Loading and error messages -->
        <TextView
            android:id="@+id/text_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_md"
            android:background="@drawable/bg_card"
            android:elevation="@dimen/elevation_card"
            android:gravity="center"
            android:padding="@dimen/screen_padding"
            android:accessibilityLiveRegion="polite"
            android:text="@string/detail_loading"
            android:textColor="@color/teeup_text_secondary"
            android:textSize="@dimen/text_body"
            android:visibility="visible" />

        <!-- Shown by the Activity after data loads -->
<Button android:id="@+id/qa_retry" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/profile_retry" android:visibility="gone" />
        <LinearLayout
            android:id="@+id/group_detail_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Tee-time information -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_md"
                android:background="@drawable/bg_card"
                android:elevation="@dimen/elevation_card"
                android:orientation="vertical"
                android:padding="@dimen/space_lg">

                <TextView
                    android:id="@+id/text_teetime_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/teeup_text_primary"
                    android:textSize="@dimen/text_subheading"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/text_teetime_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:textColor="@color/teeup_text_secondary"
                    android:textSize="@dimen/text_body" />

                <Button
                    android:id="@+id/button_preview_course"
                    style="@style/TeeUpButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:text="@string/detail_preview_course" />

            </LinearLayout>

            <!-- Host information -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_lg"
                android:background="@drawable/bg_card"
                android:elevation="@dimen/elevation_card"
                android:orientation="vertical"
                android:padding="@dimen/space_lg">

                <TextView
                    style="@style/TeeUpEyebrow"
                    android:layout_width="match_parent"
                    android:layout_marginBottom="@dimen/space_sm"
                    android:text="@string/detail_host" />

                <TextView
                    android:id="@+id/text_host_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/teeup_text_primary"
                    android:textSize="@dimen/text_body_large" />

                <TextView
                    android:id="@+id/text_host_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:textColor="@color/teeup_text_secondary"
                    android:textSize="@dimen/text_body" />

            </LinearLayout>

            <!-- EME-312: every current member with their handicap/pace, not just counts -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_lg"
                android:background="@drawable/bg_card"
                android:elevation="@dimen/elevation_card"
                android:orientation="vertical"
                android:padding="@dimen/space_lg">

                <TextView
                    style="@style/TeeUpEyebrow"
                    android:layout_width="match_parent"
                    android:layout_marginBottom="@dimen/space_sm"
                    android:text="@string/detail_members" />

                <LinearLayout
                    android:id="@+id/members_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

            </LinearLayout>

            <Button
                android:id="@+id/button_request_to_join"
                style="@style/TeeUpButton.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_sm"
                android:text="@string/detail_request_to_join" />

            <!-- EME-323: shown to a guest with a still-pending join request of their own -->
            <Button
                android:id="@+id/button_withdraw_request"
                style="@style/TeeUpButton.Compact"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_lg"
                android:text="@string/teetime_withdraw_request"
                android:visibility="gone" />

            <!-- EME-321: host-only edit/cancel/delete actions for their own group -->
            <LinearLayout
                android:id="@+id/host_actions_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_lg"
                android:orientation="vertical"
                android:visibility="gone">

                <Button
                    android:id="@+id/button_edit_group"
                    style="@style/TeeUpButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_sm"
                    android:text="@string/teetime_edit_group" />

                <Button
                    android:id="@+id/button_cancel_group"
                    style="@style/TeeUpButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_sm"
                    android:text="@string/teetime_cancel_group" />

                <Button
                    android:id="@+id/button_delete_group"
                    style="@style/TeeUpButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_button_danger_outline"
                    android:textColor="@color/teeup_danger"
                    android:text="@string/teetime_delete_group" />

            </LinearLayout>

            <!-- Pending requests -->
            <LinearLayout
                android:id="@+id/row_pending_requests"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_sm"
                android:minHeight="@dimen/touch_target"
                android:background="@drawable/bg_card_interactive"
                android:elevation="@dimen/elevation_card"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="@dimen/space_lg">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/detail_pending_requests"
                    android:textColor="@color/teeup_text_primary"
                    android:textSize="@dimen/text_body_large" />

                <TextView
                    android:id="@+id/text_pending_requests_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:textColor="@color/teeup_text_secondary"
                    android:textSize="@dimen/text_body" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>
