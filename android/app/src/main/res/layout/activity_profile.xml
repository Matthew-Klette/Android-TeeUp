<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_screen_gradient">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/screen_padding">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_xl"
                android:text="@string/profile_title"
                android:textColor="@color/teeup_text_primary"
                android:textSize="@dimen/text_heading"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/bg_logo_mask"
                android:clipToOutline="true"
                android:src="@drawable/ic_logo"
                android:scaleType="centerCrop"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/text_profile_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:gravity="center"
                android:text="@string/profile_name_placeholder"
                android:textColor="@color/teeup_text_primary"
                android:textSize="@dimen/text_subheading"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text_profile_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:layout_marginBottom="@dimen/space_xl"
                android:gravity="center"
                android:text="@string/profile_details_placeholder"
                android:textColor="@color/teeup_text_secondary"
                android:textSize="@dimen/text_body" />

            <!-- Profile loading, error message, and retry action -->
            <ProgressBar
                android:id="@+id/profile_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="@dimen/space_md"
                android:visibility="gone" />

            <TextView
                android:id="@+id/text_profile_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_md"
                android:accessibilityLiveRegion="polite"
                android:gravity="center"
                android:textColor="@color/teeup_text_secondary"
                android:textSize="@dimen/text_body"
                android:visibility="gone" />

            <Button
                android:id="@+id/button_profile_retry"
                style="@style/TeeUpButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_lg"
                android:text="@string/profile_retry"
                android:visibility="gone" />

            <!-- Statistics placeholders; real values are added later -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_xl"
                android:background="@drawable/bg_card"
                android:elevation="@dimen/elevation_card"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:padding="@dimen/space_lg">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/profile_stat_rounds"
                    android:textColor="@color/teeup_text_secondary"
                    android:textSize="@dimen/text_body" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/profile_stat_handicap"
                    android:textColor="@color/teeup_text_secondary"
                    android:textSize="@dimen/text_body" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/profile_stat_friends"
                    android:textColor="@color/teeup_text_secondary"
                    android:textSize="@dimen/text_body" />
            </LinearLayout>

            <TextView
                style="@style/TeeUpEyebrow"
                android:layout_width="match_parent"
                android:layout_marginBottom="@dimen/space_md"
                android:text="@string/profile_section_account" />

            <TextView
                android:id="@+id/row_personal_details"
                style="@style/ProfileRow"
                android:text="@string/profile_personal_details" />

            <TextView
                android:id="@+id/row_playing_details"
                style="@style/ProfileRow"
                android:text="@string/profile_playing_details" />

            <TextView
                android:id="@+id/row_notification_preferences"
                style="@style/ProfileRow"
                android:text="@string/profile_notification_preferences" />

            <TextView
                android:id="@+id/row_language"
                style="@style/ProfileRow"
                android:text="@string/profile_language" />

            <TextView
                android:id="@+id/row_biometric_login"
                style="@style/ProfileRow"
                android:text="@string/profile_biometric_login" />

            <TextView
                android:id="@+id/row_offline_sync"
                style="@style/ProfileRow"
                android:text="@string/profile_offline_sync" />

            <TextView
                android:id="@+id/row_privacy"
                style="@style/ProfileRow"
                android:text="@string/profile_privacy" />

            <Button
                android:id="@+id/button_sign_out"
                style="@style/TeeUpButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:text="@string/privacy_sign_out" />

        </LinearLayout>
    </ScrollView>

    <include layout="@layout/bottom_nav" />

</LinearLayout>
