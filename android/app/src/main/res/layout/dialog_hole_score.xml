<?xml version="1.0" encoding="utf-8"?>
<!-- Add score dialog body, shown over the in-round hole map. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_padding"
    android:paddingTop="@dimen/space_md"
    android:paddingEnd="@dimen/screen_padding">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_sm"
        android:text="@string/scorecard_strokes"
        android:textColor="@color/teeup_text_secondary"
        android:textSize="@dimen/text_body_large" />

    <EditText
        android:id="@+id/input_strokes"
        style="@style/TeeUpInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_lg"
        android:hint="@string/scorecard_strokes_hint"
        android:imeOptions="actionNext"
        android:importantForAutofill="no"
        android:inputType="number"
        android:maxLength="2" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_sm"
        android:text="@string/scorecard_putts"
        android:textColor="@color/teeup_text_secondary"
        android:textSize="@dimen/text_body_large" />

    <EditText
        android:id="@+id/input_putts"
        style="@style/TeeUpInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/scorecard_putts_hint"
        android:imeOptions="actionDone"
        android:importantForAutofill="no"
        android:inputType="number"
        android:maxLength="2" />

</LinearLayout>
