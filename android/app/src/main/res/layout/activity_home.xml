<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/teeup_background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/screen_padding">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_avatar_circle"
                    android:importantForAccessibility="no" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_md"
                    android:layout_weight="1"
                    android:text="@string/app_name"
                    android:textColor="@color/teeup_text_primary"
                    android:textSize="@dimen/text_subheading"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/button_notifications"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/touch_target"
                    android:minWidth="@dimen/touch_target"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:padding="@dimen/space_sm"
                    android:text="@string/home_notifications"
                    android:textColor="@color/teeup_accent"
                    android:textSize="@dimen/text_body" />

            </LinearLayout>

            <!-- Page title -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:text="@string/home_title"
                android:textColor="@color/teeup_text_primary"
                android:textSize="@dimen/text_heading"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:layout_marginBottom="@dimen/space_lg"
                android:text="@string/home_area"
                android:textColor="@color/teeup_accent_secondary"
                android:textSize="@dimen/text_caption" />

            <!-- Search -->
            <EditText
                android:id="@+id/input_search"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_md"
                android:hint="@string/home_search_hint"
                android:inputType="text"
                android:imeOptions="actionSearch"
                android:maxLines="1" />

            <!-- Date and player filters -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_sm"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/button_filter_datetime"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_sm"
                    android:layout_weight="1"
                    android:text="@string/home_filter_datetime" />

                <Button
                    android:id="@+id/button_filter_players"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/home_filter_players" />

            </LinearLayout>

            <Button
                android:id="@+id/button_filter_skill"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_xl"
                android:text="@string/home_filter_skill" />

            <!-- Results -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_md"
                android:text="@string/home_results_heading"
                android:textColor="@color/teeup_text_secondary"
                android:textSize="@dimen/text_caption"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:gravity="center"
                android:padding="@dimen/screen_padding"
                android:accessibilityLiveRegion="polite"
                android:text="@string/home_loading"
                android:textColor="@color/teeup_text_secondary"
                android:textSize="@dimen/text_body" />
<Button android:id="@+id/qa_retry" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/profile_retry" android:visibility="gone" />

            <LinearLayout
                android:id="@+id/tee_times_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>

    </ScrollView>

    <include layout="@layout/bottom_nav" />

</LinearLayout>