<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_screen_gradient">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/screen_padding">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_logo_mask_small"
                    android:clipToOutline="true"
                    android:src="@drawable/ic_logo"
                    android:scaleType="centerCrop"
                    android:importantForAccessibility="no" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_md"
                    android:layout_weight="1"
                    android:text="@string/app_name"
                    android:textColor="@color/teeup_text_primary"
                    android:textSize="@dimen/text_subheading"
                    android:textStyle="bold" />

                <FrameLayout
                    android:id="@+id/button_notifications"
                    android:layout_width="@dimen/touch_target"
                    android:layout_height="@dimen/touch_target"
                    android:background="@drawable/bg_nav_item"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_bell"
                        android:tint="@color/teeup_text_primary"
                        android:contentDescription="@string/home_notifications" />

                </FrameLayout>

            </LinearLayout>

            <!-- Page title -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:text="@string/home_title"
                android:textColor="@color/teeup_text_primary"
                android:textSize="@dimen/text_heading"
                android:textStyle="bold" />

            <TextView
                style="@style/TeeUpEyebrow"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/space_xs"
                android:layout_marginBottom="@dimen/space_lg"
                android:text="@string/home_area" />

            <!-- Search -->
            <EditText
                android:id="@+id/input_search"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_md"
                android:drawableStart="@drawable/ic_search"
                android:drawablePadding="@dimen/space_sm"
                android:hint="@string/home_search_hint"
                android:inputType="text"
                android:imeOptions="actionSearch"
                android:maxLines="1" />

            <!-- Date and player filters -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_sm"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/button_filter_datetime"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_sm"
                    android:layout_weight="1"
                    android:text="@string/home_filter_datetime" />

                <Button
                    android:id="@+id/button_filter_players"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/home_filter_players" />

            </LinearLayout>

            <!-- EME-312: course/holes filters, alongside the existing date/players/skill ones -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_sm"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/button_filter_course"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_sm"
                    android:layout_weight="1"
                    android:text="@string/home_filter_course" />

                <Button
                    android:id="@+id/button_filter_holes"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/home_filter_holes" />

            </LinearLayout>

            <Button
                android:id="@+id/button_filter_skill"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_sm"
                android:text="@string/home_filter_skill" />

            <Button
                android:id="@+id/button_filter_mine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_md"
                android:text="@string/home_filter_mine_off" />

            <!-- EME-311: persistent entry point, reachable whether or not groups already exist -->
            <Button
                android:id="@+id/button_create_group"
                style="@style/TeeUpButton.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_xl"
                android:text="@string/home_create_group" />

            <!-- Results -->
            <TextView
                style="@style/TeeUpEyebrow"
                android:layout_width="match_parent"
                android:layout_marginBottom="@dimen/space_md"
                android:text="@string/home_results_heading" />

            <TextView
                android:id="@+id/text_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:elevation="@dimen/elevation_card"
                android:gravity="center"
                android:padding="@dimen/screen_padding"
                android:accessibilityLiveRegion="polite"
                android:text="@string/home_loading"
                android:textColor="@color/teeup_text_secondary"
                android:textSize="@dimen/text_body" />

            <Button
                android:id="@+id/button_retry"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_md"
                android:text="@string/profile_retry"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/tee_times_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>

    </ScrollView>

    <include layout="@layout/bottom_nav" />

</LinearLayout>
