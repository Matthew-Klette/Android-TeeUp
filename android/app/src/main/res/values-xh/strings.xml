    <!-- Privacy &amp; Data (POPIA) Screen -->
    <string name="privacy_title">Ubumfihlo &amp; Idatha (POPIA)</string>
    <string name="privacy_section_collect">OKU SIKUQOKELELAYO</string>
    <string name="privacy_body_collect">Igama lakho elibonisiweyo, inkomba ye-handicap, ibala lasekhaya, kunye nenketho yesantya sokudlala — konke kunokuhlelwa ngaphantsi kweInkcukacha Zomntu neInkcukacha Zokudlala — kunye nesazisi i-Firebase esikhuphayo xa ungena nge-Google. Inketho yakho yolwimi (Iprofayile → Ulwimi) igcinwa kule divayisi kuphela, hayi kwiseva.</string>
    <string name="privacy_section_usage">INDLELA ESISETYENZISWA NGAYO</string>
    <string name="privacy_body_usage">Ukukubonisa amaxesha okudlala akufuphi, ukukudibanisa nemijikelo, nokuvumela abanini-ndlu ukuba babone ukuba ngubani ocela ukudibana. Ayithengiswa okanye yabelwane namaqela wesithathu.</string>
    <string name="privacy_section_controls">OLAWULO LWAKHO</string>
    <string name="privacy_body_controls">Ungahlela okanye ucime amabala eprofayile yakho nangaliphi na ixesha ngaphantsi kweInkcukacha Zomntu / Inkcukacha Zokudlala, kwaye uphume ngezantsi. Ukucima iakhawunti ngaphakathi kwe-app akukafumaneki okwangoku — cela oko ngokuthe ngqo kwiqela okwangoku.</string>
