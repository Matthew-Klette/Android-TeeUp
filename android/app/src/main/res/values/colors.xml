<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light theme (design-integration redesign): resembles Wedge's much-whiter,
         cleaner look rather than the old near-black theme. Same token names/roles
         as before — every consumer below just picks up new values, nothing else
         had to change. Surfaces: a soft off-white page background with crisp
         white cards on top (separated by a hairline/shadow, not a tonal jump). -->
    <color name="teeup_background">#F6F8F3</color>
    <color name="teeup_surface">#FFFFFF</color>
    <color name="teeup_surface_alt">#ECF0E7</color>
    <color name="teeup_surface_high">#DEE6D6</color>

    <!-- Brand green (iOS redesign: deep royal golf green, matching design/Theme.kt): used sparingly now — the primary CTA fill, the selected nav
         tab, a handful of borders/links. Body and button text is near-black/gray
         by default (see color/button_text.xml, styles.xml TeeUpEyebrow); green is
         a highlight, not the default text color. Deeper than the old dark-theme
         accent so it still reads at proper contrast on a white surface. -->
    <color name="teeup_accent">#006747</color>

    <!-- Text: near-black/gray is the default everywhere; green is reserved for the
         handful of spots above. -->
    <color name="teeup_text_primary">#14170F</color>
    <color name="teeup_text_secondary">#5B6459</color>
    <color name="teeup_text_disabled">#A8B0A2</color>

    <!-- Borders and touch feedback: subtle hairlines, not a second accent color. -->
    <color name="teeup_border">#DCE3D6</color>
    <color name="teeup_ripple">#33006747</color>

    <!-- Status -->
    <color name="teeup_danger">#C4362A</color>

    <!-- iOS redesign: the Compose palette (design/Theme.kt TeeUpColors) for the few XML views
         still drawn inside Compose screens (the hole map's WebView and distances). -->
    <color name="ios_label">#1D1D1F</color>
    <color name="ios_secondary_label">#6E6E73</color>
    <color name="ios_accent">#006747</color>
</resources>
