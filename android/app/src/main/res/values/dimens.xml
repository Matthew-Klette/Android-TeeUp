<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Shared spacing -->
    <dimen name="space_md">12dp</dimen>
    <dimen name="space_lg">16dp</dimen>

    <!-- Controls and navigation -->
    <dimen name="touch_target">48dp</dimen>

    <!-- Rounded corners: restrained, not pill-shaped. Nav pill stays fully
         rounded since a stadium indicator is the deliberate exception. -->
    <dimen name="card_radius">10dp</dimen>
    <dimen name="button_radius">8dp</dimen>
    <!-- ic_logo.png is a flat opaque square with no alpha channel, so clipping it to this
         via clipToOutline (see bg_logo_mask) is what actually rounds it, not the asset. -->

    <!-- Elevation: soft lift so surfaces read as layered, not flat -->
    <dimen name="elevation_banner">10dp</dimen>

    <!-- Shared text sizes -->
    <dimen name="text_body">14sp</dimen>
    <dimen name="text_body_large">16sp</dimen>
</resources>